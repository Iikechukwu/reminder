# Copy this file to .env and fill in real values. .env is gitignored.
# Never put real secrets in this file.

# Neon "pooled" connection string (host contains "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require

# Neon "direct" connection string (no "-pooler"). Used by the worker and migrations.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Same, but pointing at the Neon "test" branch. pytest uses ONLY this one.
TEST_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@TESTHOST/DBNAME?sslmode=require

# Shared secret used to sign webhook events (HMAC-SHA256). Generate a random one.
WEBHOOK_SECRET=change-me
